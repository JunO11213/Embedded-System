BEGIN
{
    printf("%-15s %-20s %-10s %-18s %-10s %s\n", 
           "TIME", "EVENT", "PREV_PID", "PREV_COMM", "NEXT_PID", "NEXT_COMM");
}

tracepoint:sched:sched_process_exec
/comm == "t_app.out"/
{
    printf("%-15s %-20s %-10d %-18s => %-10s %s\n",
           strftime("%H:%M:%S.%f", nsecs),
           "sched_process_exec",
           pid, comm,
           "", str(args->filename));
}

tracepoint:sched:sched_switch
/args->prev_comm == "t_app.out" || args->next_comm == "t_app.out"/
{
    printf("%-15s %-20s %-10d %-18s => %-10d %s\n",
           strftime("%H:%M:%S.%f", nsecs),
           "sched_switch",
           args->prev_pid, args->prev_comm,
           args->next_pid, args->next_comm);
}

tracepoint:sched:sched_process_exit
/comm == "t_app.out"/
{
    printf("%-15s %-20s %-10d %-18s => %-10s %s\n",
           strftime("%H:%M:%S.%f", nsecs),
           "sched_process_exit",
           pid, comm,
           "", "");
}